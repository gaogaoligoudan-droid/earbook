<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- M2 在线引擎预留，M1 不联网 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ 包可见性：不声明则看不到任何 TTS 引擎（绑定返回 -1，真机同样会失败） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EarBook">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="设置" />

        <activity
            android:name=".WizardActivity"
            android:exported="false"
            android:label="欢迎使用 EarBook" />

        <activity
            android:name=".BookManageActivity"
            android:exported="false"
            android:label="书籍管理" />

        <activity
            android:name=".StorageActivity"
            android:exported="false"
            android:label="存储管理" />

        <service
            android:name=".service.ReadAloudService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- M2 前台渲染服务：离线音频渲染属特殊用途（specialUse 无 dataSync 的 6h/天配额，
             长书全书渲染需要）；subtype 说明用于 Android 14+ 校验 -->
        <service
            android:name=".service.RenderService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="offline_tts_chapter_rendering" />
        </service>
    </application>

</manifest>
